# Usuário (padrão: Admin) e senha do portal /admin
ADMIN_USER=Admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo longo e aleatório: assina a sessão do admin e criptografa a chave de IA salva
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Criado automaticamente ao conectar um Vercel Blob Store ao projeto.
# Sem ele, em desenvolvimento local, as configurações ficam em .data/settings.json
BLOB_READ_WRITE_TOKEN=

# Opcional: chave usada caso nenhuma seja cadastrada pelo portal
ANTHROPIC_API_KEY=

# Envio de e-mail dos contatos (Resend)
RESEND_API_KEY=
EMAIL_FROM=Site Ramon Advocacia <site@seudominio.com.br>
